<Window x:Class="VECLauncher.Views.ModBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Страница мода"
        Height="720" Width="1060"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/logo.ico"
        FontFamily="Segoe UI">

    <Border Background="#0A0A0C" CornerRadius="12" BorderBrush="#262626" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="48" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="#0C0C0E">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Click="BtnBack_Click" IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="←" FontSize="14" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnForward" Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Click="BtnForward_Click" IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="→" FontSize="14" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnReload" Width="30" Height="30" Padding="0"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Click="BtnReload_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="↻" FontSize="14" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="5" Margin="10,0,0,0"
                        Background="#1A1A1A" ClipToBounds="True" VerticalAlignment="Center">
                    <Image x:Name="ImgIcon" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="2" Margin="8,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Загрузка…" FontWeight="SemiBold" FontSize="12"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtUrl" Text="" FontSize="10" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Width="30" Height="30" Padding="0" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="✕" FontSize="12" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A1515"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="1,0">
                <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>

                <StackPanel x:Name="PanelFallback" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="⏳" FontSize="38" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFallback" Text="Открываю страницу…"
                               FontSize="13" Margin="0,14,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock x:Name="TxtFallbackHint" Text="" FontSize="11" Margin="0,8,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="#777"/>
                </StackPanel>
            </Grid>

            <!-- Bottom bar -->
            <Border Grid.Row="2" Background="#0E0E0E" CornerRadius="0,0,12,12"
                    BorderBrush="#262626" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11" Foreground="#777"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Height="32" MinWidth="90" Cursor="Hand"
                                Background="#1A1A1A" BorderThickness="0" Click="BtnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A1A1A" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#252525"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Закрыть" FontSize="11" Foreground="#999"/>
                        </Button>
                        <Button x:Name="BtnInstall" Style="{StaticResource AccentButton}" Content="Установить"
                                Height="32" MinWidth="160" Margin="8,0,0,0" FontSize="11" Click="BtnInstall_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
