<Window x:Class="VECLauncher.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEC Launcher"
        Width="540" Height="410"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/logo.ico"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="#09090D" CornerRadius="18"
            BorderBrush="#1E1E2C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.75" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <!-- Subtle background ambient glow -->
            <Ellipse Width="380" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0" IsHitTestVisible="False" Opacity="0.10">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4ADE80" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header branding -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" ClipToBounds="True" Background="#14141E" Margin="0,0,10,0">
                            <Image Source="pack://application:,,,/logo.ico" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="VEC" FontWeight="ExtraBold" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text=" PLATFORM" FontWeight="ExtraBold" FontSize="20" Foreground="#ECECED" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="ПОДГОТОВКА ИГРОВОГО ОКРУЖЕНИЯ" FontSize="9.5" FontWeight="Bold" Foreground="#55556E"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 3D Slime Container with Dynamic Ground Shadow & Particle Canvas -->
                <Grid Grid.Row="1" Width="360" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Dynamic Ground Shadow -->
                    <Ellipse x:Name="SlimeGroundShadow" Width="90" Height="22" VerticalAlignment="Bottom"
                             HorizontalAlignment="Center" Margin="0,0,0,30" Fill="#55000000">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="SlimeShadowScale" CenterX="45" CenterY="11" ScaleX="1.0" ScaleY="1.0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="12"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- 3D Viewport for Minecraft Slime -->
                    <Viewport3D x:Name="SplashSlimeViewport" ClipToBounds="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0, 0.4, 6.2" LookDirection="0, -0.05, -6.2" UpDirection="0,1,0" FieldOfView="40"/>
                        </Viewport3D.Camera>

                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#AAAAAA"/>
                                    <DirectionalLight Color="#FFFFFF" Direction="-0.8, -1.2, -1.5"/>
                                    <DirectionalLight Color="#557766" Direction="0.8, 0.5, 1.0"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>

                        <!-- Slime Visual with Transforms -->
                        <ModelVisual3D x:Name="SplashSlimeVisual">
                            <ModelVisual3D.Transform>
                                <Transform3DGroup>
                                    <ScaleTransform3D x:Name="SlimeScaleTransform" ScaleX="1" ScaleY="1" ScaleZ="1"/>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="SlimeRotateY" Axis="0,1,0" Angle="25"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="SlimeRotateX" Axis="1,0,0" Angle="8"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <TranslateTransform3D x:Name="SlimeTranslate" OffsetX="0" OffsetY="0" OffsetZ="0"/>
                                </Transform3DGroup>
                            </ModelVisual3D.Transform>
                        </ModelVisual3D>
                    </Viewport3D>

                    <!-- Slime Splash Particles Canvas -->
                    <Canvas x:Name="ParticleCanvas" Width="360" Height="220" IsHitTestVisible="False" ClipToBounds="False"/>
                </Grid>

                <!-- Progress Bar & Status Details -->
                <StackPanel Grid.Row="2" Width="360" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtSplashStatus" Text="Загрузка модулей..." FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#BBBBCC" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtSplashPercent" Text="0%" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Custom Progress Bar -->
                    <Border Height="6" Background="#14141E" CornerRadius="3" ClipToBounds="True" BorderBrush="#1F1F2C" BorderThickness="1">
                        <Grid HorizontalAlignment="Left">
                            <Border x:Name="SplashProgressBar" Width="0" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#4ADE80" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TxtSplashTip" Text="Проверка библиотек и профилей Minecraft..."
                               FontSize="10" Foreground="#666677" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
