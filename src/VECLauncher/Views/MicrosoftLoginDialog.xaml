<Window x:Class="VECLauncher.Views.MicrosoftLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход в учётную запись Microsoft" Height="650" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0E0E10" Foreground="#ECECED"
        WindowStyle="None" AllowsTransparency="True"
        Icon="pack://application:,,,/logo.ico">
    <Border BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="12" Background="#0E0E10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#141418" CornerRadius="12,12,0,0" Padding="16,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" Background="#0078D4" CornerRadius="4" Margin="0,0,8,0">
                            <TextBlock Text="M" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Вход в Microsoft / Xbox Live" FontWeight="SemiBold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Grid.Column="1" Content="✕" Width="28" Height="28"
                            Background="Transparent" Foreground="#888" BorderBrush="Transparent"
                            Cursor="Hand" Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- WebView2 Chromium Browser View -->
            <wv2:WebView2 x:Name="Browser" Grid.Row="1" Margin="1"/>
        </Grid>
    </Border>
</Window>
