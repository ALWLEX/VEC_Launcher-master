<Window x:Class="VECLauncher.Views.VecLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация VEC ID (КПВК)" Height="430" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0E0E10" Foreground="#ECECED"
        WindowStyle="None" AllowsTransparency="True"
        Icon="pack://application:,,,/logo.ico">
    <Border BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="12" Background="#0E0E10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#141418" CornerRadius="12,12,0,0" Padding="16,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" Background="#222" CornerRadius="4" Margin="0,0,8,0">
                            <TextBlock Text="V" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="VEC ID — Единый аккаунт КПВК" FontWeight="SemiBold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Grid.Column="1" Content="✕" Width="28" Height="28"
                            Background="Transparent" Foreground="#888" BorderBrush="Transparent"
                            Cursor="Hand" Click="BtnClose_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="24,18,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Mode Switcher (Pill Toggle) -->
                <Border Grid.Row="0" Background="#16161A" CornerRadius="8" Padding="3" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbModeLogin" Grid.Column="0" Content="Вход"
                                     IsChecked="True" Checked="Mode_Changed"
                                     Cursor="Hand" HorizontalAlignment="Stretch">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="0,7">
                                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#25252B"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton x:Name="RbModeRegister" Grid.Column="1" Content="Регистрация"
                                     Checked="Mode_Changed"
                                     Cursor="Hand" HorizontalAlignment="Stretch">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="0,7">
                                        <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#25252B"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- Input Fields -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="ИМЯ ПОЛЬЗОВАТЕЛЯ" FontSize="10" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                    <Border Background="#141418" BorderBrush="#26262E" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                        <TextBox x:Name="TxtUsername" Height="36" Background="Transparent" Foreground="White" BorderThickness="0"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5"
                                 KeyDown="Input_KeyDown"/>
                    </Border>

                    <TextBlock Text="ПАРОЛЬ" FontSize="10" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                    <Border Background="#141418" BorderBrush="#26262E" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                        <PasswordBox x:Name="TxtPassword" Height="36" Background="Transparent" Foreground="White" BorderThickness="0"
                                     Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5"
                                     KeyDown="Input_KeyDown"/>
                    </Border>

                    <!-- Status message banner -->
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="#EF4444" Margin="0,0,0,14" MinHeight="18" VerticalAlignment="Center"/>

                    <!-- Action Submit Button -->
                    <Button x:Name="BtnSubmit" Style="{StaticResource AccentButton}" Height="40" Content="Войти"
                            FontSize="13" Click="BtnSubmit_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
