<Window x:Class="VECLauncher.Views.ModVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка мода"
        Height="580" Width="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/logo.ico"
        FontFamily="Segoe UI">

    <Border Background="#0A0A0C" CornerRadius="12" BorderBrush="#262626" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                        Background="#1A1A1A" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="ImgIcon" Stretch="UniformToFill"/>
                        <TextBlock x:Name="TxtInitial" FontSize="18" FontWeight="Bold"
                                   Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Мод" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitle" Text="" Foreground="#777"
                               FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                <TextBlock Text="✕" FontSize="12" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A1515"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Filters -->
            <Border Grid.Row="1" Margin="0,14,0,0" Background="#0E0E0E" CornerRadius="8"
                    BorderBrush="#262626" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ВЕРСИЯ" FontSize="9" FontWeight="Bold" Foreground="#666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbGameVersion" Width="130" Height="32" FontSize="11"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="ЗАГРУЗЧИК" FontSize="9" FontWeight="Bold" Foreground="#666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbLoader" Width="120" Height="32" FontSize="11"
                                  SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="КАНАЛ" FontSize="9" FontWeight="Bold" Foreground="#666" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbChannel" Width="120" Height="32" FontSize="11"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Все" IsSelected="True" Tag="all"/>
                            <ComboBoxItem Content="Release" Tag="release"/>
                        </ComboBox>
                    </StackPanel>

                    <TextBlock x:Name="TxtMatchInfo" Grid.Column="3" Text="" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="10,0,0,8" Foreground="#666" FontSize="10"
                               TextWrapping="Wrap" MaxWidth="160" TextAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Version list -->
            <Border Grid.Row="2" Margin="0,10,0,0" Background="#0E0E0E" CornerRadius="8"
                    BorderBrush="#262626" BorderThickness="1" Padding="4">
                <Grid>
                    <TextBlock x:Name="TxtEmpty" Text="Загружаю…" Foreground="#666" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="LstVersions" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LstVersions_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Sel" Background="Transparent" CornerRadius="6" Padding="0">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Sel" Property="Background" Value="#15FFFFFF"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Sel" Property="Background" Value="#20FFFFFF"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="6" Padding="10,8" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="4" Padding="6,3"
                                                    VerticalAlignment="Center" Background="#1A1A1A">
                                                <TextBlock Text="{Binding TypeText}" FontSize="9" FontWeight="Bold" Foreground="#999"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Details}" FontSize="10" Foreground="#777"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#777" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CompatText}" FontSize="9" Foreground="{Binding CompatColor}"
                                                           Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Bottom -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <StackPanel VerticalAlignment="Center">
                    <CheckBox x:Name="ChkDependencies" Content="Устанавливать зависимости" IsChecked="True"
                              Foreground="#999" FontSize="11"/>
                    <TextBlock x:Name="TxtDepInfo" Text="" Foreground="#666"
                               FontSize="10" Margin="22,3,0,0" TextWrapping="Wrap" MaxWidth="340"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Height="32" MinWidth="90" Cursor="Hand" Background="#1A1A1A" BorderThickness="0"
                            Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A1A1A" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#252525"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Отмена" FontSize="11" Foreground="#999"/>
                    </Button>
                    <Button x:Name="BtnInstall" Style="{StaticResource AccentButton}" Content="Установить"
                            Height="32" MinWidth="140" Margin="8,0,0,0" FontSize="11"
                            Click="BtnInstall_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
