<Window x:Class="VECLauncher.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        Height="220" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/logo.ico"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource BgDeep}" CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.75" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Badge -->
            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="ПОДТВЕРЖДЕНИЕ" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                </StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Minecraft уже запущен" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
            </StackPanel>

            <!-- Message Body -->
            <TextBlock x:Name="TxtMessage" Grid.Row="1" Text="Запустить ещё одну копию игры?"
                       Foreground="#A0A0B2" FontSize="12.5" LineHeight="18"
                       Margin="0,10,0,10" VerticalAlignment="Center" TextWrapping="Wrap"/>

            <!-- Action Buttons (Centered) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="BtnCancel" Style="{StaticResource BaseButton}" Content="Отмена"
                        MinWidth="110" Height="36" IsCancel="True" Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" Style="{StaticResource AccentButton}" Content="Запустить"
                        MinWidth="130" Height="36" Margin="12,0,0,0" IsDefault="True" Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
