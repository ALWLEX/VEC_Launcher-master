## .gitignore for .NET / WPF project

# Build results
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Publish
*.publish.xml
publish/

# OS
Thumbs.db
.DS_Store

# Server sensitive data
server/**/data/*.db
server/**/data/*.pem
server/**/data/skins/
server/**/data/capes/

# Skin catalog (1000+ embedded PNGs)
src/**/Assets/Skins/

# Runtime logs
*.log

# Debug files
*.pdb
*.dll.mdb
*.exe.config

# Release folder contents (keep structure but ignore build outputs)
src/MCLauncher/bin/Release/**
src/MCLauncher/bin/Debug/**

# Built executable folder
билды exe/

# User-specific files
cape_default.png
cape_romashca*.png
launcher-config.json
start_auth_server.bat
Новая папка/

# Build outputs
builds/
src/builds_tmp/
